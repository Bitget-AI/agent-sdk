{
  "name": "@bitget-ai/bitget-agent-sdk",
  "version": "3.0.0",
  "description": "Spec-driven foundation SDK for the Bitget Unified Trading Account (UTA / v3) API. Generated from openapi.yaml — exposes all v3 endpoints as AI-callable tools, with a built-in catalog-driven mock server for hermetic regression testing.",
  "keywords": [
    "bitget",
    "trading",
    "cryptocurrency",
    "exchange",
    "uta",
    "openapi",
    "ai-agent",
    "llm-tools",
    "mcp",
    "rest-api",
    "spot",
    "futures"
  ],
  "license": "MIT",
  "author": "Bitget",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.14.1",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.js"
    },
    "./testing": {
      "types": "./lib/testing/index.d.ts",
      "import": "./lib/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "bin": {
    "bitget-mock-server": "./lib/bin/mock-server.js"
  },
  "files": [
    "lib",
    "openapi.yaml",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "VERSION"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "gen": "node scripts/generate-catalog.mjs",
    "regen": "pnpm run gen && pnpm run typecheck && pnpm run test",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.10.0",
    "vitest": "^2.0.0"
  }
}
